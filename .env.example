# Render'a kopyala: Dashboard → Environment Variables
TELEGRAM_BOT_TOKEN=buraya_bot_token
GROQ_API_KEY=buraya_groq_key
TELEGRAM_CHAT_ID=buraya_telegram_id

# Render deploy sonrası URL'i al, .env'e ekle
RENDER_URL=https://burkut-bot.onrender.com

# Kendin belirle — hem Render'a hem .env'e aynı değeri gir
AGENT_TOKEN=gizli_bir_sifre_yaz

# Bürküt OS yerel API (dashboard) — boşsa AGENT_TOKEN kullanılır
BURKUT_TOKEN=
# API sunucusunu kapatmak için: BURKUT_SERVER=off
BURKUT_SERVER=on
